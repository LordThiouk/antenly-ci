diff --git a/.github/workflows/opencode-task.yml b/.github/workflows/opencode-task.yml
index d56cbb9..7f66c19 100644
--- a/.github/workflows/opencode-task.yml
+++ b/.github/workflows/opencode-task.yml
@@ -116,6 +116,55 @@ jobs:
           persist-credentials: false
           token: ${{ inputs.target_repo == 'antenly-ci' && github.token || secrets.ANTENLY_TOKEN }}
 
+      - name: Checkout acr-senegal en lecture seule (cible antenly)
+        id: acr
+        if: ${{ inputs.target_repo == 'antenly' }}
+        continue-on-error: true
+        uses: actions/checkout@v4
+        with:
+          repository: LordThiouk/acr-senegal
+          token: ${{ secrets.ANTENLY_TOKEN }}
+          persist-credentials: false
+          fetch-depth: 0
+          path: ro/acr-senegal
+
+      - name: Préparer acr-senegal (branches + lecture seule)
+        id: acr_ro
+        if: ${{ inputs.target_repo == 'antenly' }}
+        env:
+          ANTENLY_TOKEN: ${{ secrets.ANTENLY_TOKEN }}
+        run: |
+          RO="$GITHUB_WORKSPACE/ro/acr-senegal"
+          case "$RO" in
+            "$GITHUB_WORKSPACE/target"|"$GITHUB_WORKSPACE/target/"*) echo "::error::acr-senegal ne doit jamais être dans target/"; exit 1;;
+          esac
+          if [ "${{ steps.acr.outcome }}" != "success" ] || [ ! -d "$RO/.git" ]; then
+            {
+              echo "### acr-senegal (lecture seule)"
+              echo ""
+              echo "Copie indisponible : le checkout a échoué (voir l'étape *Checkout acr-senegal*)."
+            } >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          ASKPASS="$RUNNER_TEMP/ro-askpass.sh"
+          cat <<'AP' > "$ASKPASS"
+          #!/bin/sh
+          echo "$ANTENLY_TOKEN"
+          AP
+          chmod 700 "$ASKPASS"
+          GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="$ASKPASS" \
+            git -C "$RO" fetch --prune origin '+refs/heads/*:refs/remotes/origin/*'
+          rm -f "$ASKPASS"
+          chmod -R a-w "$RO"
+          echo "ACR_SENEGAL_RO=$RO" >> "$GITHUB_ENV"
+          {
+            echo "### acr-senegal (lecture seule)"
+            echo ""
+            echo "- Copie réussie : \`$RO\`"
+            echo "- Branches distantes récupérées, dossier rendu non inscriptible (\`chmod -R a-w\`)."
+            echo "- Hors de \`target/\` : jamais inclus par la porte gitleaks/push."
+          } >> "$GITHUB_STEP_SUMMARY"
+
       - name: Préparer prompt et SHA de départ
         id: prep
         env:
@@ -169,6 +218,15 @@ jobs:
           fi
           cat "$raw" >> "$RUNNER_TEMP/oc/prompt.md"
 
+          if [ -n "${ACR_SENEGAL_RO:-}" ]; then
+            cat <<CTX >> "$RUNNER_TEMP/oc/prompt.md"
+
+          ## Dépôt de référence en lecture seule
+          - Une copie de \`LordThiouk/acr-senegal\` (toutes les branches distantes) est disponible en lecture seule ici : \`$ACR_SENEGAL_RO\`.
+          - Sers-t'en pour comparer les moteurs d'empreinte ; ne tente jamais de la modifier (dossier en lecture seule, hors dépôt cible).
+          CTX
+          fi
+
       - name: Installer Node, Python/uv, opencode et gitleaks
         run: |
           npm install -g --no-fund --no-audit "opencode-ai@${OPENCODE_VERSION}" >/dev/null 2>&1
